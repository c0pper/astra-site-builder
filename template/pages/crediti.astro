---
import Base from '../layouts/Base.astro';
import { loadSite } from '../lib/site';

const { site, images } = loadSite();
const used = images.credits;
---

<Base title={`Crediti – ${site.business.name}`}>
  <article class="container-page max-w-3xl space-y-5 py-14">
    <h1 class="text-4xl font-bold">Crediti</h1>

    {
      used.length > 0 && (
        <section>
          <h2 class="mt-8 text-2xl font-bold">Fotografie</h2>
          <ul class="mt-4 space-y-2">
            {used.map((img) => (
              <li>
                Foto di {img.authorUrl ? <a href={img.authorUrl} class="underline" rel="noopener">{img.author}</a> : img.author} su{' '}
                <a href={img.sourceUrl} class="underline" rel="noopener">{img.source}</a> (
                {img.licenceUrl ? <a href={img.licenceUrl} class="underline" rel="noopener">{img.licence}</a> : img.licence})
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <h2 class="mt-8 text-2xl font-bold">Caratteri e mappe</h2>
      <p class="mt-4">
        Caratteri tipografici distribuiti con licenza SIL Open Font License tramite Fontsource. Dati cartografici ©
        contributori di <a href="https://www.openstreetmap.org/copyright" class="underline" rel="noopener">OpenStreetMap</a>.
      </p>
      {
        site.business.geo && (
          <p class="mt-4">
            Sfondo della mappa: mappa di Newport (Isola di Wight) © contributori di OpenStreetMap, elaborazione di{' '}
            <a href="https://commons.wikimedia.org/wiki/User:Ricardalovesmonuments" class="underline" rel="noopener">Ricardalovesmonuments</a> su{' '}
            <a href="https://commons.wikimedia.org/wiki/File:Newport_(Isle_of_Wight)_city_centre_Openstreetmap_2026.jpg" class="underline" rel="noopener">Wikimedia Commons</a> (
            <a href="https://creativecommons.org/licenses/by/4.0" class="underline" rel="noopener">CC BY 4.0</a>)
          </p>
        )
      }
    </section>
  </article>
</Base>
