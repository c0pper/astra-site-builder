---
import Section from '../Section.astro';
import { loadSite } from '../../lib/site';

const { site } = loadSite();
const brands = site.retail?.brands ?? [];
---

<Section id="marchi-disponibili" title="Marchi disponibili">
  <ul class="flex flex-wrap gap-3">
    {brands.map((brand) => <li class="rounded-full border border-text/15 bg-surface px-5 py-2 font-semibold">{brand}</li>)}
  </ul>
</Section>
