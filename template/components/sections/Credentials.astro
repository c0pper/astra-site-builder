---
// Health `credentials` section: title, specialisations, Albo registration and languages, each only as a source states it.
import Section from '../Section.astro';
import { formatList } from '../../lib/format';
import { loadSite } from '../../lib/site';

const { site } = loadSite();
const { title, specializations = [], registration, languages = [] } = site.health!;
---

<Section id="profilo" title="Profilo professionale">
  <dl class="grid max-w-3xl gap-6 text-lg sm:grid-cols-2">
    {
      title && (
        <div>
          <dt class="text-sm text-muted">Titolo</dt>
          <dd class="font-semibold">{title}</dd>
        </div>
      )
    }
    {
      registration && (
        <div>
          <dt class="text-sm text-muted">Iscrizione all'Albo</dt>
          <dd class="font-semibold">
            {registration.board}
            {registration.number && `, n. ${registration.number}`}
          </dd>
        </div>
      )
    }
    {
      specializations.length > 0 && (
        <div class="sm:col-span-2">
          <dt class="text-sm text-muted">Specializzazioni</dt>
          <dd>
            <ul class="mt-1 space-y-1 font-semibold">
              {specializations.map((s) => <li>{s}</li>)}
            </ul>
          </dd>
        </div>
      )
    }
    {
      languages.length > 0 && (
        <div class="sm:col-span-2">
          <dt class="text-sm text-muted">Lingue</dt>
          <dd class="font-semibold">Anche in {formatList(languages.map((l) => l.toLowerCase()))}</dd>
        </div>
      )
    }
  </dl>
</Section>
