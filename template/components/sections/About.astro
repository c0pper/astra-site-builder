---
import { Picture } from 'astro:assets';
import Section from '../Section.astro';
import { loadSite } from '../../lib/site';

const { site, images, voice } = loadSite();
const paragraphs = (site.copy.about ?? '').split(/\n\s*\n/).filter(Boolean);
const image = images.about;
---

<Section id="chi-siamo" title={voice.about}>
  <div class:list={['grid items-center gap-10', image && 'md:grid-cols-2']}>
    <div class="max-w-prose space-y-4 text-lg">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    {
      image && (
        <Picture
          src={image.src}
          alt={image.alt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="aspect-[4/3] w-full rounded-2xl object-cover"
        />
      )
    }
  </div>
</Section>
