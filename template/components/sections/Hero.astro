---
import { Picture } from 'astro:assets';
import ContactButtons from '../ContactButtons.astro';
import OpenStatus from '../OpenStatus.astro';
import { formatRating } from '../../lib/format';
import { loadSite } from '../../lib/site';

const { site, images, label, heroLayout: variant, heroUnderHeader } = loadSite();
const b = site.business;
const image = images.hero;
const heading = site.copy.headline ?? b.name;
const eyebrow = `${label} a ${b.address.city}`;
// Full-bleed heroes slide up under the transparent header (h-16, Header.astro) and add its height back as padding.
const underHeader = heroUnderHeader && '-mt-16';
---

{
  variant === 'centered' && (
    <section class:list={['bg-primary text-on-primary', underHeader]}>
      <div class:list={['container-page pb-20 text-center sm:pb-28', underHeader ? 'pt-36 sm:pt-44' : 'pt-20 sm:pt-28']}>
        <p class="text-sm font-semibold tracking-widest uppercase">{eyebrow}</p>
        <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-bold sm:text-6xl">{heading}</h1>
        {site.copy.tagline && <p class="mx-auto mt-5 max-w-2xl text-lg">{site.copy.tagline}</p>}
        <OpenStatus tone="onDark" class="mt-6" />
        {b.rating && (
          <p class="mt-4 text-sm">
            ★ {formatRating(b.rating.value)} · {b.rating.count} recensioni
          </p>
        )}
        <div class="mt-8 flex justify-center">
          <ContactButtons tone="onDark" />
        </div>
      </div>
    </section>
  )
}

{
  variant === 'split' && image && (
    <section class="bg-surface">
      <div class="container-page grid items-center gap-10 py-14 md:grid-cols-2 md:py-20">
        <div>
          <p class="text-sm font-semibold tracking-widest text-ink uppercase">{eyebrow}</p>
          <h1 class="mt-3 text-4xl font-bold sm:text-5xl">{heading}</h1>
          {site.copy.tagline && <p class="mt-5 text-lg text-muted">{site.copy.tagline}</p>}
          <OpenStatus class="mt-6" />
          {b.rating && (
            <p class="mt-4 text-sm text-muted">
              ★ {formatRating(b.rating.value)} · {b.rating.count} recensioni
            </p>
          )}
          <div class="mt-8">
            <ContactButtons />
          </div>
        </div>
        <div class="overflow-hidden rounded-2xl">
          <Picture
            src={image.src}
            alt={image.alt}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] w-full object-cover motion-safe:animate-hero-zoom"
          />
        </div>
      </div>
    </section>
  )
}

{
  variant === 'overlay' && image && (
    <section class:list={['relative isolate overflow-hidden text-white', underHeader]}>
      <Picture
        src={image.src}
        alt={image.alt}
        formats={['avif', 'webp']}
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-20 h-full w-full object-cover motion-safe:animate-hero-zoom"
      />
      <div class="absolute inset-0 -z-10 bg-black/65" />
      <div class:list={['container-page pb-24 sm:pb-32', underHeader ? 'pt-40 sm:pt-48' : 'pt-24 sm:pt-32']}>
        <p class="text-sm font-semibold tracking-widest uppercase opacity-90">{eyebrow}</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-bold sm:text-6xl">{heading}</h1>
        {site.copy.tagline && <p class="mt-5 max-w-2xl text-lg opacity-90">{site.copy.tagline}</p>}
        <OpenStatus tone="onDark" class="mt-6" />
        {b.rating && (
          <p class="mt-4 text-sm opacity-90">
            ★ {formatRating(b.rating.value)} · {b.rating.count} recensioni
          </p>
        )}
        <div class="mt-8">
          <ContactButtons tone="onDark" />
        </div>
      </div>
    </section>
  )
}
