---
// Shared wrapper: consistent spacing, an anchor id, and the section heading.
// Backgrounds alternate by position (styles/global.css), so hidden sections never leave two alike in a row.
interface Props {
  id: string;
  title?: string;
  intro?: string;
}
const { id, title, intro } = Astro.props;
---

<section id={id} class="scroll-mt-4 py-14 sm:py-20">
  <div class="container-page">
    {
      title && (
        <div class="mb-8 max-w-2xl">
          <h2 class="text-3xl font-bold text-ink sm:text-4xl">{title}</h2>
          {intro && <p class="mt-3 text-lg text-muted">{intro}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>
