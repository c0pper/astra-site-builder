---
import { href, telHref } from '../lib/format';
import { loadSite } from '../lib/site';

const { site, label } = loadSite();
const { name, phone } = site.business;
---

<header class="border-b border-text/10 bg-surface">
  <div class="container-page flex items-center justify-between gap-4 py-3">
    <a href={href()} class="min-w-0 leading-tight">
      <span class="block truncate font-heading text-xl font-bold text-ink sm:text-2xl">{name}</span>
      <span class="block text-xs tracking-wide text-muted uppercase">{label} · {site.business.address.city}</span>
    </a>
    {
      phone && (
        <a href={telHref(phone)} class="btn hidden shrink-0 bg-primary text-on-primary hover:opacity-90 sm:inline-flex">
          Chiama {phone}
        </a>
      )
    }
  </div>
</header>
